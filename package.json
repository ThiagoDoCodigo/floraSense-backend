{
  "name": "florasense",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:mem": "npx --node-arg=\"--max-old-space-size=8192\" ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --verbose",
    "test:unit": "jest -c jest.unit.config.ts --runInBand --verbose",
    "test:integration": "cross-env NODE_ENV=test jest -c jest.integration.config.ts --runInBand --verbose",
    "test:e2e": "cross-env NODE_ENV=test jest -c jest.e2e.config.ts --runInBand --verbose",
    "sync": "ts-node -r dotenv/config src/data/sync.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "@google/generative-ai": "^0.24.1",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-socket.io": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pgvector": "^0.2.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.0"
  },
  "overrides": {
    "fastify-socket.io": {
      "fastify": "$fastify"
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.8.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
